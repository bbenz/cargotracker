# Copy this file to .env and fill in your model endpoint. .env is in .gitignore. Do not commit it.

# Turn the assistant on or off. The rest of the app works either way.
AI_ENABLED=true

# Any OpenAI-compatible endpoint, for example:
#   Azure OpenAI in Microsoft Foundry: https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
#   OpenAI:                            https://api.openai.com/v1
#   GitHub Models:                     https://models.github.ai/inference (use AI_API=chat-completions)
#   Ollama from compose.yaml:          http://ollama:11434/v1 (use AI_API=chat-completions)
AI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
AI_API_KEY=replace-with-your-key

# The model name, or the deployment name in Azure OpenAI.
AI_CHAT_MODEL=gpt-6.1-sol

# "responses" for the Responses API, or "chat-completions".
AI_API=responses

# For reasoning models: low, medium, or high. Leave it empty for other models.
AI_REASONING_EFFORT=low

# Seconds to wait for one model call before the page shows the fallback.
AI_TIMEOUT_SECONDS=20

# Live traffic on the dashboard. You can also turn it on in the page.
DEMO_TRAFFIC_ENABLED=false
DEMO_TRAFFIC_INTERVAL_SECONDS=20
